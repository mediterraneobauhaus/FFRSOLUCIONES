<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>FFR Soluciones</title>
<meta name="description" content="Trabajamos bien. Instalamos, colocamos, reparamos, reformamos y proyectamos en CABA y GBA. Tu casa, tu oficina, tu negocio.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@200;300;400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#000;--ink:#fff;--muted:#a3a3a3;--line:#3a3a3a;--y:#edc944;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{background:#000;scroll-padding-top:70px}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 "Inter Tight",system-ui,"Helvetica Neue",Arial,sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:#000;z-index:30}
a{color:inherit}
:focus-visible{outline:2px solid var(--y);outline-offset:3px}
.wrap{max-width:1040px;margin:0 auto;padding:0 22px}
.light{--bg:#f1f1ee;--ink:#000;--muted:#555;--line:#c8c8c3;background:var(--bg);color:var(--ink)}
.yellow{--bg:var(--y);--ink:#000;--muted:#000;--line:#000;background:var(--y);color:#000}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:#000;border-bottom:1px solid #3a3a3a}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:66px;gap:12px}
.hlogo{display:block;height:42px;width:auto;color:#fff}
nav{display:flex;gap:26px;align-items:center;font-size:15px}
nav a{text-decoration:none;color:#fff;font-weight:300;padding:4px 0;border-bottom:1px solid transparent}
nav a[aria-current]{border-color:var(--y);font-weight:500}
nav a.pill{border:1px solid #fff;border-radius:99px;padding:7px 16px;font-weight:500}
#menu{display:none;background:none;border:1px solid #fff;color:#fff;font:500 14px inherit;padding:7px 14px;border-radius:99px;cursor:pointer}
@media(max-width:780px){#menu{display:block}
nav{display:none;position:absolute;top:66px;left:0;right:0;background:#000;flex-direction:column;align-items:flex-start;padding:18px 22px 24px;gap:16px;border-bottom:1px solid #3a3a3a;font-size:20px}
nav.open{display:flex}}
.thin{font-weight:200;letter-spacing:-.045em;line-height:1;margin:0}
h1.thin{font-size:clamp(46px,8.6vw,96px)}
h2.thin{font-size:clamp(34px,6vw,60px)}
.lead{font-weight:300;font-size:clamp(18px,2.4vw,22px);max-width:30em;color:var(--muted);margin:22px 0 0}
section{padding:84px 0;background:var(--bg);color:var(--ink)}
section.tight{padding-top:0}
h2+*{margin-top:30px}
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.btn{display:inline-block;background:var(--y);color:#000;font:700 16px "Inter Tight",sans-serif;text-decoration:none;padding:14px 22px;border:1px solid var(--y);cursor:pointer;letter-spacing:-.01em}
.btn.o{background:transparent;color:var(--ink);border-color:var(--ink);font-weight:500}
.yellow .btn{background:#000;color:#fff;border-color:#000}
.hero{padding:70px 22px 80px;display:grid;gap:48px 64px;grid-template-columns:1.35fr 1fr;align-items:end}
@media(max-width:860px){.hero{grid-template-columns:1fr}}
.idx{list-style:none;margin:0;padding:0 0 0 0;border-left:2px solid var(--ink)}
.idx li{position:relative;padding-left:34px}
.idx li::before{content:"";position:absolute;left:0;top:50%;width:22px;border-top:2px solid var(--ink)}
.idx li:last-child{border-left:0;margin-left:-2px;padding-left:36px}
.idx li:last-child::before{left:2px}
.idx a{display:flex;align-items:center;gap:16px;text-decoration:none;font-weight:500;font-size:clamp(30px,4.4vw,44px);letter-spacing:-.045em;padding:9px 0;line-height:1.1}
.idx a:hover{color:var(--y)}
.idx svg{width:30px;height:30px;flex:none;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;opacity:.9}
.rows{border-top:2px solid var(--ink)}
.row{display:grid;grid-template-columns:64px 1fr;gap:4px 22px;padding:26px 0;border-bottom:1px solid var(--line);text-decoration:none;align-items:start}
.row:hover h3{color:var(--y)}
.light .row:hover h3{text-decoration:underline}
.row svg{width:44px;height:44px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.row h3{margin:0;font-weight:500;font-size:clamp(30px,5vw,46px);letter-spacing:-.045em;line-height:1.05}
.row p{margin:6px 0 0;color:var(--muted);font-weight:300;max-width:34em}
.cols{display:grid;gap:34px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
.cols>div{border-top:2px solid var(--ink);padding-top:16px}
.cols h3{margin:0 0 6px;font-weight:500;font-size:26px;letter-spacing:-.04em}
.cols p{margin:0;color:var(--muted);font-weight:300}
.steps{counter-reset:s;display:grid;gap:34px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
.steps>div{counter-increment:s;border-top:2px solid var(--ink);padding-top:14px}
.steps>div::before{content:counter(s);font-weight:200;font-size:56px;letter-spacing:-.05em;line-height:1;display:block;margin-bottom:8px}
.steps h3{margin:0 0 4px;font-weight:500;font-size:24px;letter-spacing:-.035em}
.steps p{margin:0;color:var(--muted);font-weight:300}
.box{border:1px solid var(--ink);padding:clamp(22px,4vw,40px);display:grid;gap:26px 48px;grid-template-columns:1fr 1.4fr;align-items:center}
@media(max-width:700px){.box{grid-template-columns:1fr}}
.price{font-weight:500;font-size:clamp(58px,11vw,100px);line-height:.95;letter-spacing:-.05em}
.dark .price,.box .price{color:var(--y)}
.light .box .price{color:#000}
.box small{display:block;color:var(--ink);font-weight:300;font-size:18px;line-height:1.4;margin-top:10px;max-width:15em}
.box ul,.list{margin:0;padding:0;list-style:none}
.box li,.list li{padding:9px 0;border-bottom:1px solid var(--line);font-weight:300;font-size:19px}
.box li:last-child,.list li:last-child{border:0}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px}
.chip{background:none;color:var(--ink);border:1px solid var(--ink);border-radius:99px;padding:7px 16px;font:400 15px "Inter Tight",sans-serif;cursor:pointer}
.chip[aria-pressed=true]{background:var(--ink);color:var(--bg)}
.grid{display:grid;gap:26px 18px;grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}
.work{text-decoration:none;display:block}
.work .ph{aspect-ratio:4/3;background:#161616;display:grid;place-items:center;overflow:hidden}
.work img{width:100%;height:100%;object-fit:cover;display:block}
.work h3{margin:12px 0 2px;font-weight:500;font-size:22px;letter-spacing:-.03em}
.work p{margin:0;color:var(--muted);font-weight:300;font-size:15px}
.photos{columns:2 280px;column-gap:12px}
.photos figure{margin:0 0 12px;break-inside:avoid}
.photos img{width:100%;display:block}
.photos figcaption{font-size:14px;color:var(--muted);padding-top:6px}
.back{display:inline-block;font-weight:300;text-decoration:none;margin-bottom:26px;border-bottom:1px solid currentColor}
.meta{color:var(--muted);font-weight:300;margin:14px 0 0}
details{border-bottom:1px solid var(--line);padding:16px 0}
summary{cursor:pointer;font-weight:500;font-size:20px}
details p{margin:10px 0 0;color:var(--muted);font-weight:300;max-width:40em}
.two{display:grid;gap:44px;grid-template-columns:1.1fr 1fr}
@media(max-width:760px){.two{grid-template-columns:1fr}}
.cl{display:grid;gap:16px;align-content:start}
.cl a{text-decoration:none;font-weight:200;letter-spacing:-.035em;font-size:clamp(22px,4.4vw,36px);line-height:1.15;word-break:break-word}
.cl a:hover{text-decoration:underline;text-underline-offset:6px}
.cl span{display:block;font-size:14px;font-weight:500;color:var(--muted);letter-spacing:0}
form{display:grid;gap:14px;align-content:start}
label{font-size:14px;font-weight:500;display:grid;gap:6px;color:var(--muted)}
input,select,textarea{font:inherit;color:var(--ink);background:transparent;border:1px solid var(--ink);padding:12px 14px;width:100%;border-radius:0}
select option{background:#fff;color:#000}
.note{color:var(--muted);font-weight:300}
footer{background:#000;color:#fff;padding:44px 0 36px;font-weight:300;font-size:15px}
footer .wrap{display:flex;flex-wrap:wrap;gap:24px 60px;justify-content:space-between;align-items:flex-start}
footer a{display:block;text-decoration:none;padding:2px 0}
footer a:hover{text-decoration:underline}
.flogo{height:64px;width:auto;display:block;color:#fff}
footer{padding:64px 0 36px}
footer .wrap{display:block}
.fgrid{display:grid;gap:40px 48px;grid-template-columns:1.2fr 1fr 1fr}
@media(max-width:760px){.fgrid{grid-template-columns:1fr}}
.fgrid h4{margin:0 0 12px;font-weight:500;font-size:14px;color:#a3a3a3}
.fgrid p{margin:14px 0 0;color:#a3a3a3;max-width:16em}
footer .fgrid a{font-size:17px;padding:4px 0;word-break:break-word}
.fsign{margin:64px 0 0;padding-top:28px;border-top:1px solid #3a3a3a}
.fsign b{display:block;font-weight:200;letter-spacing:-.05em;line-height:1;font-size:clamp(48px,11vw,128px)}
.fsign small{display:block;margin-top:22px;color:#a3a3a3;font-size:14px}
[hidden]{display:none!important}
</style>
</head>
